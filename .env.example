# Copy to .env for local development (see README.md).
DATABASE_URL=postgresql://jester:jester@localhost:5432/jester
# Separate database for `pnpm test`; it is wiped between tests.
TEST_DATABASE_URL=postgresql://jester:jester@localhost:5432/jester_test

# "dev" signs every request in as a fixed local admin. Refused in production.
AUTH_MODE=dev
REQUIRED_GROUP=jester
ADMIN_GROUP=jester-admin
PUBLIC_URL=http://localhost:3000

# The dev server runs the worker in-process; production splits web and worker.
JOBS_ENABLED=true

# MinIO from compose.yaml
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=jester
AWS_SECRET_ACCESS_KEY=jester-secret
MEDIA_BUCKET=centerpoint-jester-media
S3_ENDPOINT=http://localhost:9000

# Optional features (off without their credentials).
# OPENROUTER_API_KEY=
# AI_DAILY_BUDGET_USD=1
# IMMICH_URL=https://immich.vidur.xyz
# IMMICH_API_KEY=
# Keep false locally: true permanently deletes imported assets from Immich.
IMMICH_DELETE_ENABLED=false
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# TOKEN_ENCRYPTION_KEY=   # openssl rand -base64 32
SCHEDULE_TIMEZONE=Asia/Kolkata
