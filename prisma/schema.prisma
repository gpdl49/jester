// Data model: docs/memes.md "Data model" in gpdl49/homestacks is the
// contract. Change it there first; slices never edit this file without the
// coordinator's go-ahead.
//
// The connection URL lives in ../prisma.config.ts (CLI) and lib/db (runtime).
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

// IDs are UUIDv7 generated by Prisma (time-ordered). `updatedAt` also has a
// database default so raw SQL inserts need not set it.

enum TriageStatus {
  unscored // below the prefilter threshold
  pending // queued for triage.classify
  scored
  accepted
  rejected
  imported
  deleted // imported and removed from Immich
  error
}

enum MemeSource {
  immich
  upload
}

enum MemeStatus {
  inbox
  approved
  rejected
  archived
}

enum TagKind {
  topic
  template
  style
  user
}

enum TagSource {
  ai
  user
}

enum AnalysisKind {
  triage
  meme
  attribution
}

enum AnalysisStatus {
  queued
  running
  done
  failed
}

enum AttributionPlatform {
  instagram
  x
  reddit
  tiktok
  tumblr
  ninegag
  ifunny
  web
  other
}

enum UploadStatus {
  pending
  complete
  imported
  failed
}

enum DeletionStatus {
  pending
  done
  skipped
  failed
}

enum PostKind {
  image
  carousel
}

enum PostStatus {
  draft
  queued
  publishing
  published
  failed
  cancelled
}

model User {
  id        String   @id @default(uuid(7)) @db.Uuid
  sub       String   @unique
  email     String?
  username  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("users")
}

model Setting {
  key         String   @id
  value       Json
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("settings")
}

model SyncState {
  id                String    @id // "immich"
  cursor            String? // ISO timestamp for updatedAfter
  backfillPage      Int       @default(1) @map("backfill_page") // progress counter (pages read), not a resume point
  backfillCursor    String?   @map("backfill_cursor") // ISO fileCreatedAt of the last asset seen; backfill resume point
  backfillStartedAt DateTime? @map("backfill_started_at")
  backfillDone      Boolean   @default(false) @map("backfill_done")
  smartDone         Boolean   @default(false) @map("smart_done")
  lastRunAt         DateTime? @map("last_run_at")
  lastError         String?   @map("last_error")

  @@map("sync_state")
}

model ImmichAsset {
  id               String       @id @default(uuid(7)) @db.Uuid
  immichId         String       @unique @map("immich_id") @db.Uuid
  checksum         String // Immich base64 SHA-1 of the original
  originalFileName String       @map("original_file_name")
  mimeType         String       @map("mime_type")
  width            Int?
  height           Int?
  fileCreatedAt    DateTime?    @map("file_created_at")
  cameraMake       String?      @map("camera_make")
  cameraModel      String?      @map("camera_model")
  ocrText          String?      @map("ocr_text")
  prefilterScore   Float        @default(0) @map("prefilter_score")
  prefilterSignals Json         @default("{}") @map("prefilter_signals")
  smartHits        String[]     @default([]) @map("smart_hits")
  triageStatus     TriageStatus @default(unscored) @map("triage_status")
  memeProbability  Float?       @map("meme_probability")
  triageModel      String?      @map("triage_model")
  triageResult     Json?        @map("triage_result")
  decidedById      String?      @map("decided_by_id") @db.Uuid
  decidedAt        DateTime?    @map("decided_at")
  memeId           String?      @unique @map("meme_id") @db.Uuid
  error            String?
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at")

  meme      Meme?            @relation(fields: [memeId], references: [id], onDelete: SetNull)
  deletions ImmichDeletion[]

  @@index([triageStatus, memeProbability])
  @@index([prefilterScore])
  @@map("immich_assets")
}

model Meme {
  id              String     @id @default(uuid(7)) @db.Uuid
  source          MemeSource
  status          MemeStatus @default(inbox)
  contentType     String     @map("content_type")
  size            Int
  width           Int?
  height          Int?
  sha256          String     @unique // hex
  dhash           String? // 16 hex chars (64-bit difference hash)
  blurhash        String?
  takenAt         DateTime?  @map("taken_at")
  ocrText         String?    @map("ocr_text")
  description     String?
  altText         String?    @map("alt_text")
  template        String?
  language        String?
  era             String?
  postability     Int? // 0-100
  captionDraft    String?    @map("caption_draft")
  hashtags        String[]   @default([])
  /// {nsfw, politics, slurs, personalData, notes}
  sensitivity     Json?
  /// {lowRes, heavyCompression, cropped, watermark}
  quality         Json?
  rating          Int? // 1-5
  notes           String?
  duplicateOfId   String?    @map("duplicate_of_id") @db.Uuid
  attributionId   String?    @unique @map("attribution_id") @db.Uuid
  creditText      String?    @map("credit_text")
  renditionsReady Boolean    @default(false) @map("renditions_ready")
  /// AI-filled fields the user has edited; analysis never overwrites these.
  userEdited      String[]   @default([]) @map("user_edited")
  /// Generated column (see the init migration): weighted tsvector over
  /// template, description, ocr_text, alt_text. Query with raw SQL only.
  search          Unsupported("tsvector")?
  approvedById    String?    @map("approved_by_id") @db.Uuid
  approvedAt      DateTime?  @map("approved_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @default(now()) @updatedAt @map("updated_at")

  duplicateOf Meme?                  @relation("Duplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates  Meme[]                 @relation("Duplicates")
  attribution AttributionCandidate?  @relation("ConfirmedAttribution", fields: [attributionId], references: [id], onDelete: SetNull)
  candidates  AttributionCandidate[] @relation("Candidates")
  immichAsset ImmichAsset?
  tags        MemeTag[]
  analyses    Analysis[]
  postItems   PostItem[]
  uploads     Upload[]
  deletions   ImmichDeletion[]

  @@index([status, createdAt])
  @@index([postability])
  @@index([dhash])
  @@map("memes")
}

model Tag {
  id    String    @id @default(uuid(7)) @db.Uuid
  name  String    @unique // lowercase slug
  kind  TagKind   @default(topic)
  memes MemeTag[]

  @@map("tags")
}

model MemeTag {
  memeId String    @map("meme_id") @db.Uuid
  tagId  String    @map("tag_id") @db.Uuid
  source TagSource @default(ai)

  meme Meme @relation(fields: [memeId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([memeId, tagId])
  @@index([tagId])
  @@map("meme_tags")
}

model Analysis {
  id        String         @id @default(uuid(7)) @db.Uuid
  memeId    String?        @map("meme_id") @db.Uuid // null for triage (asset not imported yet)
  kind      AnalysisKind
  model     String?
  status    AnalysisStatus @default(queued)
  result    Json?
  error     String?
  costUsd   Float?         @map("cost_usd")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @default(now()) @updatedAt @map("updated_at")

  meme       Meme?                  @relation(fields: [memeId], references: [id], onDelete: Cascade)
  candidates AttributionCandidate[]

  @@index([memeId, kind, createdAt])
  @@map("analyses")
}

model AttributionCandidate {
  id            String              @id @default(uuid(7)) @db.Uuid
  memeId        String              @map("meme_id") @db.Uuid
  analysisId    String?             @map("analysis_id") @db.Uuid
  creatorName   String?             @map("creator_name")
  handle        String?
  platform      AttributionPlatform
  url           String?
  evidence      String
  confidence    Float
  rank          Int
  confirmedById String?             @map("confirmed_by_id") @db.Uuid
  confirmedAt   DateTime?           @map("confirmed_at")
  rejectedAt    DateTime?           @map("rejected_at")
  createdAt     DateTime            @default(now()) @map("created_at")

  meme        Meme      @relation("Candidates", fields: [memeId], references: [id], onDelete: Cascade)
  analysis    Analysis? @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  confirmedOn Meme?     @relation("ConfirmedAttribution")

  @@index([memeId, rank])
  @@map("attribution_candidates")
}

model Upload {
  id          String       @id @default(uuid(7)) @db.Uuid
  uploaderId  String       @map("uploader_id") @db.Uuid
  contentType String       @map("content_type")
  size        Int
  status      UploadStatus @default(pending)
  memeId      String?      @map("meme_id") @db.Uuid
  error       String?
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at")

  meme Meme? @relation(fields: [memeId], references: [id], onDelete: SetNull)

  @@map("uploads")
}

model ImmichDeletion {
  id             String         @id @default(uuid(7)) @db.Uuid
  immichAssetId  String         @map("immich_asset_id") @db.Uuid
  immichId       String         @map("immich_id") @db.Uuid
  memeId         String?        @map("meme_id") @db.Uuid
  status         DeletionStatus @default(pending)
  verifiedSha256 String?        @map("verified_sha256")
  error          String?
  at             DateTime       @default(now())

  immichAsset ImmichAsset @relation(fields: [immichAssetId], references: [id], onDelete: Cascade)
  meme        Meme?       @relation(fields: [memeId], references: [id], onDelete: SetNull)

  @@index([at])
  @@map("immich_deletions")
}

model InstagramAccount {
  id             String   @id @default(uuid(7)) @db.Uuid
  igUserId       String   @unique @map("ig_user_id")
  username       String
  /// lib/instagram/crypto encrypt(): base64(iv | tag | ciphertext), AES-256-GCM
  accessTokenEnc String   @map("access_token_enc")
  tokenExpiresAt DateTime @map("token_expires_at")
  connectedById  String?  @map("connected_by_id") @db.Uuid
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  posts Post[]
  slots ScheduleSlot[]

  @@map("instagram_accounts")
}

model Post {
  id            String     @id @default(uuid(7)) @db.Uuid
  accountId     String?    @map("account_id") @db.Uuid // null: the default account at publish time
  kind          PostKind
  status        PostStatus @default(draft)
  caption       String     @default("")
  /// Unscheduled queued posts are ordered by queuePosition, then createdAt.
  queuePosition Int?       @map("queue_position")
  scheduledAt   DateTime?  @map("scheduled_at")
  slotId        String?    @map("slot_id") @db.Uuid
  /// Carousel: children first, parent last. Single image: one id.
  containerIds  String[]   @default([]) @map("container_ids")
  containerAt   DateTime?  @map("container_at")
  igMediaId     String?    @map("ig_media_id")
  permalink     String?
  publishedAt   DateTime?  @map("published_at")
  attempts      Int        @default(0)
  error         String?
  createdById   String?    @map("created_by_id") @db.Uuid
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @default(now()) @updatedAt @map("updated_at")

  account InstagramAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  slot    ScheduleSlot?     @relation(fields: [slotId], references: [id], onDelete: SetNull)
  items   PostItem[]

  @@index([status, scheduledAt])
  @@map("posts")
}

model PostItem {
  postId   String  @map("post_id") @db.Uuid
  memeId   String  @map("meme_id") @db.Uuid
  position Int // 0-9
  altText  String? @map("alt_text")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  meme Meme @relation(fields: [memeId], references: [id], onDelete: Restrict)

  @@id([postId, position])
  @@unique([postId, memeId])
  @@index([memeId])
  @@map("post_items")
}

model ScheduleSlot {
  id        String  @id @default(uuid(7)) @db.Uuid
  accountId String? @map("account_id") @db.Uuid
  weekday   Int // 0-6, 0 = Sunday
  time      String // HH:MM in SCHEDULE_TIMEZONE
  enabled   Boolean @default(true)

  account InstagramAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  posts   Post[]

  @@unique([accountId, weekday, time])
  @@map("schedule_slots")
}

model AiUsage {
  id               String   @id @default(uuid(7)) @db.Uuid
  kind             String // triage | meme | attribution
  model            String
  promptTokens     Int      @default(0) @map("prompt_tokens")
  completionTokens Int      @default(0) @map("completion_tokens")
  costUsd          Float    @default(0) @map("cost_usd")
  refId            String?  @map("ref_id")
  at               DateTime @default(now())

  @@index([at])
  @@map("ai_usage")
}

model AuditEvent {
  id          String   @id @default(uuid(7)) @db.Uuid
  actorId     String?  @map("actor_id") @db.Uuid
  action      String
  subjectType String   @map("subject_type")
  subjectId   String?  @map("subject_id")
  data        Json     @default("{}")
  at          DateTime @default(now())

  @@index([at])
  @@index([action, at])
  @@map("audit_events")
}
